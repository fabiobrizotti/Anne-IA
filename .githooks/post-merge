#!/usr/bin/env bash
# ==============================================================================
# ANNE-IA — GIT POST-MERGE HOOK
# ==============================================================================
# Dispara a sincronização do .env quando um `git pull`/`git merge` traz
# alterações em .env.example. A lógica vive em sync-env-if-changed (compartilhada
# com o post-rewrite, que cobre `git pull --rebase`).
#
# Habilitar no repositório local (uma vez por clone):
#   git config core.hooksPath .githooks
# ==============================================================================

set -euo pipefail

exec "$(dirname "${BASH_SOURCE[0]}")/sync-env-if-changed" ORIG_HEAD
