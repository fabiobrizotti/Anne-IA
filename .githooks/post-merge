#!/usr/bin/env bash
# ==============================================================================
# ANNE-IA — GIT POST-MERGE HOOK
# ==============================================================================
# Dispara automaticamente a sincronização do .env caso o .env.example tenha
# sofrido alterações no git pull / merge.
#
# Para habilitar este hook no repositório local:
#   git config core.hooksPath .githooks
# ==============================================================================

set -euo pipefail

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# Verifica se .env.example foi modificado no último merge
if git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD 2>/dev/null | grep -q '^\.env\.example$'; then
  echo ""
  echo "==================================================================="
  echo "  [hook] Alterações detectadas em .env.example após git pull!"
  echo "  Sincronizando .env automaticamente..."
  echo "==================================================================="
  if [[ -x "${PROJECT_ROOT}/scripts/sync-env.sh" ]]; then
    "${PROJECT_ROOT}/scripts/sync-env.sh"
  fi
fi
