# ==============================================================================
# SENHAS E CHAVES DE ACESSO
# ==============================================================================

CHAVE_POSTGRES_PASSWORD=
CHAVE_RABBITMQ_DEFAULT_PASS=
CHAVE_REDIS_PASSWORD=
N8N_ENCRYPTION_KEY=
RABBITMQ_DEFAULT_PASS=
POSTGRES_PASSWORD=
GITHUB_TOKEN=
REDIS_PASSWORD=
# EVOLUTION API
AUTHENTICATION_API_KEY=

# ==============================================================================
# FECHADO - SENHAS E CHAVES DE ACESSO
# ==============================================================================

# ==============================================================================
# N8N - CORE & CONECTIVIDADE
# ==============================================================================
TZ=America/Sao_Paulo
GENERIC_TIMEZONE=America/Sao_Paulo
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/


# ==============================================================================
# N8N - PROVISIONAMENTO AUTOMÁTICO (INSTANCE OWNER)
# ==============================================================================
N8N_INSTANCE_OWNER_MANAGED_BY_ENV=true
N8N_INSTANCE_OWNER_EMAIL=
N8N_INSTANCE_OWNER_FIRST_NAME=Admin
N8N_INSTANCE_OWNER_LAST_NAME=Admin
# Senha: "anneai" (Usar aspas simples com $ individual no arquivo .env)
N8N_INSTANCE_OWNER_PASSWORD_HASH='$2a$12$A1Ev4wdNEG8bu7Ch1vMt7OF/NZUqq0WhT.vTQ9Do.CWUKU4AZkPCG'

# ==============================================================================
# N8N - PACOTES DA COMUNIDADE & PERMISSÕES
# ==============================================================================
N8N_COMMUNITY_PACKAGES_MANAGED_BY_ENV=true
N8N_COMMUNITY_PACKAGES=[{"name":"n8n-nodes-evolution-api"}]
N8N_RUNNERS_STDLIB_ALLOW=*
N8N_RUNNERS_EXTERNAL_ALLOW=*

# ==============================================================================
# EVOLUTION API - VARIÁVEIS DE AMBIENTE COMPLETAS
# ==============================================================================

# --- SERVIDOR E SISTEMA ---
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://localhost:8081
LANGUAGE=pt-BR

# --- AUTENTICAÇÃO ---

AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# --- CORS ---
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

# --- LOGS ---
LOG_LEVEL=ERROR,WARN,DEBUG,INFO,LOG,VERBOSE,DARK,WEBHOOKS
LOG_COLOR=true
LOG_BAILEYS=error

# --- INSTÂNCIAS E SESSÃO ---
DEL_INSTANCE=false
CONFIG_SESSION_PHONE_CLIENT=Evolution API
CONFIG_SESSION_PHONE_NAME=Chrome
# CONFIG_SESSION_PHONE_VERSION=2.3000.1045542031
QRCODE_LIMIT=30
QRCODE_COLOR=#175197

# --- TELEMETRIA ---
TELEMETRY=false
TELEMETRY_URL=

# --- BANCO DE DADOS (POSTGRESQL) ---
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:${CHAVE_POSTGRES_PASSWORD}@db-evolution:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange

# Persistência de Dados no Banco
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true

# --- CACHE (REDIS) ---
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://:${CHAVE_REDIS_PASSWORD}@redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# --- WEBHOOK GLOBAL ---
WEBHOOK_GLOBAL_ENABLED=true
WEBHOOK_GLOBAL_URL=http://n8n:5678/webhook/upsertmessage
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false
WEBHOOK_GLOBAL_WEBHOOK_BASE64=true

# Eventos de Webhook (Apenas MESSAGES_UPSERT ativo)
WEBHOOK_EVENTS_APPLICATION_STARTUP=false
WEBHOOK_EVENTS_QRCODE_UPDATED=false
WEBHOOK_EVENTS_MESSAGES_SET=false
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
WEBHOOK_EVENTS_MESSAGES_EDITED=false
WEBHOOK_EVENTS_MESSAGES_UPDATE=false
WEBHOOK_EVENTS_MESSAGES_DELETE=false
WEBHOOK_EVENTS_SEND_MESSAGE=false
WEBHOOK_EVENTS_CONTACTS_SET=false
WEBHOOK_EVENTS_CONTACTS_UPSERT=false
WEBHOOK_EVENTS_CONTACTS_UPDATE=false
WEBHOOK_EVENTS_PRESENCE_UPDATE=false
WEBHOOK_EVENTS_CHATS_SET=false
WEBHOOK_EVENTS_CHATS_UPSERT=false
WEBHOOK_EVENTS_CHATS_UPDATE=false
WEBHOOK_EVENTS_CHATS_DELETE=false
WEBHOOK_EVENTS_GROUPS_UPSERT=false
WEBHOOK_EVENTS_GROUPS_UPDATE=false
WEBHOOK_EVENTS_GROUP_PARTICIPANTS_UPDATE=false
WEBHOOK_EVENTS_CONNECTION_UPDATE=false
WEBHOOK_EVENTS_LABELS_EDIT=false
WEBHOOK_EVENTS_LABELS_ASSOCIATION=false
WEBHOOK_EVENTS_CALL=false
WEBHOOK_EVENTS_TYPEBOT_START=false
WEBHOOK_EVENTS_TYPEBOT_CHANGE_STATUS=false
WEBHOOK_EVENTS_ERRORS=false
WEBHOOK_EVENTS_ERRORS_WEBHOOK=false

# --- RABBITMQ (DESATIVADO) ---
RABBITMQ_ENABLED=false
RABBITMQ_URI=amqp://root:${CHAVE_RABBITMQ_DEFAULT_PASS}@rabbitmq:5672
RABBITMQ_EXCHANGE_NAME=evolution
RABBITMQ_GLOBAL_ENABLED=false
RABBITMQ_EVENTS_APPLICATION_STARTUP=false
RABBITMQ_EVENTS_INSTANCE_CREATE=false
RABBITMQ_EVENTS_INSTANCE_DELETE=false
RABBITMQ_EVENTS_QRCODE_UPDATED=false
RABBITMQ_EVENTS_MESSAGES_SET=false
RABBITMQ_EVENTS_MESSAGES_UPSERT=false
RABBITMQ_EVENTS_MESSAGES_EDITED=false
RABBITMQ_EVENTS_MESSAGES_UPDATE=false
RABBITMQ_EVENTS_MESSAGES_DELETE=false
RABBITMQ_EVENTS_SEND_MESSAGE=false
RABBITMQ_EVENTS_CONTACTS_SET=false
RABBITMQ_EVENTS_CONTACTS_UPSERT=false
RABBITMQ_EVENTS_CONTACTS_UPDATE=false
RABBITMQ_EVENTS_PRESENCE_UPDATE=false
RABBITMQ_EVENTS_CHATS_SET=false
RABBITMQ_EVENTS_CHATS_UPSERT=false
RABBITMQ_EVENTS_CHATS_UPDATE=false
RABBITMQ_EVENTS_CHATS_DELETE=false
RABBITMQ_EVENTS_GROUPS_UPSERT=false
RABBITMQ_EVENTS_GROUP_UPDATE=false
RABBITMQ_EVENTS_GROUP_PARTICIPANTS_UPDATE=false
RABBITMQ_EVENTS_CONNECTION_UPDATE=false
RABBITMQ_EVENTS_CALL=false
RABBITMQ_EVENTS_TYPEBOT_START=false
RABBITMQ_EVENTS_TYPEBOT_CHANGE_STATUS=false

# --- WEBSOCKET (DESATIVADO) ---
WEBSOCKET_ENABLED=false
WEBSOCKET_GLOBAL_EVENTS=false

# --- SQS (DESATIVADO) ---
SQS_ENABLED=false
SQS_ACCESS_KEY_ID=
SQS_SECRET_ACCESS_KEY=
SQS_ACCOUNT_ID=
SQS_REGION=

# --- AMAZON S3 / MINIO (DESATIVADO) ---
S3_ENABLED=false
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=evolution
S3_PORT=443
S3_ENDPOINT=s3.amazonaws.com
S3_USE_SSL=true

# --- WHATSAPP CLOUD API (META OFICIAL - DESATIVADO) ---
WA_BUSINESS_TOKEN_WEBHOOK=
WA_BUSINESS_URL=https://graph.facebook.com
WA_BUSINESS_VERSION=v20.0
WA_BUSINESS_LANGUAGE=pt_BR

# --- INTEGRAÇÕES NATIVAS (DESATIVADAS) ---
TYPEBOT_API_VERSION=latest
CHATWOOT_ENABLED=false
CHATWOOT_MESSAGE_READ=false
CHATWOOT_MESSAGE_DELETE=false
CHATWOOT_IMPORT_DATABASE_CONNECTION_URI=
CHATWOOT_IMPORT_PLACEHOLDER_MEDIA_MESSAGE=false
OPENAI_ENABLED=false
DIFY_ENABLED=false

# ==============================================================================
# REDIS - CACHE, DEBOUNCE & MEMÓRIA VOLÁTIL
# ==============================================================================
REDIS_PORT=6379


# Limite de Memória e Estratégia de Descarte (Protege contra queda por falta de RAM)
REDIS_MAX_MEMORY=256mb
REDIS_MAX_MEMORY_POLICY=allkeys-lru
# ==============================================================================
# POSTGRESQL - BANCO DE DADOS PRINCIPAL
# ==============================================================================
POSTGRES_DB=evolution
POSTGRES_USER=evolution
POSTGRES_PORT=5432

# Parâmetros de Performance e Localização
POSTGRES_INITDB_ARGS=--encoding=UTF-8 --lc-collate=C --lc-ctype=C

# ==============================================================================
# RABBITMQ - BROKER DE MENSAGENS (pré-configurado via setup/rabbitmq)
# ==============================================================================
# A senha RABBITMQ_DEFAULT_PASS (definida no topo deste arquivo) tem duplo uso:
#   1. Cria o usuário administrador padrão (RABBITMQ_DEFAULT_USER) no container;
#   2. É injetada pelo setup/rabbitmq/entrypoint.sh no definitions.json gerado a
#      partir do template, criando as filas quorum (client-infos, format-message).
# Mantenha as mesmas força em CHAVE_RABBITMQ_DEFAULT_PASS e RABBITMQ_DEFAULT_PASS.
RABBITMQ_DEFAULT_USER=root
RABBITMQ_ERLANG_COOKIE=${RABBITMQ_DEFAULT_PASS}
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672


