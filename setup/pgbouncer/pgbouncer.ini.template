; ============================================================================
; PGBOUNCER CONFIGURATION TEMPLATE
; ============================================================================
; This file is processed by entrypoint.sh which substitutes ${VAR} placeholders
; from the environment. Do not edit the generated file directly.
; ============================================================================

[databases]
; Transaction pool for applications (Dashboard)
; pool_mode=transaction: releases connection back to pool after each transaction
anneia = host=${POSTGRES_HOST} port=${POSTGRES_PORT} dbname=anneia pool_mode=transaction pool_size=20

; Session pool for admin tools (pgAdmin, pg_dump, migrations)
; pool_mode=session: keeps connection for entire session (required for prepared statements, temp tables)
anneia_session = host=${POSTGRES_HOST} port=${POSTGRES_PORT} dbname=anneia pool_mode=session pool_size=5

; Read-only pool do spend do LiteLLM para o financeiro do Dashboard
litellm = host=${POSTGRES_HOST} port=${POSTGRES_PORT} dbname=litellm pool_mode=transaction pool_size=5

; Evolution API database pool
evolution = host=${EVOLUTION_DB_HOST} port=${EVOLUTION_DB_PORT} dbname=${EVOLUTION_DB_NAME} pool_mode=${EVOLUTION_DB_POOL_MODE} pool_size=${EVOLUTION_DB_POOL_SIZE}

[pgbouncer]
; Network
listen_addr = ${PGBOUNCER_LISTEN_ADDR}
listen_port = ${PGBOUNCER_CONTAINER_PORT}

; Pooling
pool_mode = transaction
max_client_conn = 500
default_pool_size = 20
min_pool_size = 5
reserve_pool_size = 5
reserve_pool_timeout = 3
max_db_connections = 40

; Timeouts
server_idle_timeout = 300
server_lifetime = 3600
server_connect_timeout = 15
query_wait_timeout = 30
query_timeout = 0
idle_transaction_timeout = 0

; Prepared statements (DISABLED for transaction mode compatibility)
; Enable only with PgBouncer >= 1.21 and after validation
max_prepared_statements = 0

; Authentication
auth_type = plain
auth_file = /etc/pgbouncer/userlist.txt
admin_users = pgbouncer_admin

; Logging
log_connections = 1
log_disconnections = 1
log_pooler_errors = 1
stats_period = 60

; TLS (disabled - Tailscale WireGuard provides encryption)
; client_tls_sslmode = disable
; server_tls_sslmode = disable

; Admin console - disabled for security
; admin_addr = 127.0.0.1
; admin_port = 6433

; Ignore unsupported startup parameters (e.g., statement_timeout from clients)
ignore_startup_parameters = extra_float_digits, statement_timeout