{
  "rabbit_version": "3.13.0",
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "users": [
    {
      "name": "root",
      "password": "__RABBITMQ_DEFAULT_PASS__",
      "tags": [
        "administrator"
      ]
    }
  ],
  "permissions": [
    {
      "user": "root",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "exchanges": [
    {
      "name": "evolution",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "anne.direct.work",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "anne.direct.dlx",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "anne.inbound.raw.q",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-delivery-limit": 3,
        "x-dead-letter-exchange": "anne.direct.dlx",
        "x-dead-letter-routing-key": "dlq.inbound"
      }
    },
    {
      "name": "anne.ai.process.q",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-delivery-limit": 2,
        "x-dead-letter-exchange": "anne.direct.dlx",
        "x-dead-letter-routing-key": "dlq.ai"
      }
    },
    {
      "name": "anne.outbound.dispatch.q",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-delivery-limit": 3,
        "x-dead-letter-exchange": "anne.direct.dlx",
        "x-dead-letter-routing-key": "dlq.outbound"
      }
    },
    {
      "name": "anne.inbound.raw.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "anne.ai.process.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "anne.outbound.dispatch.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    }
  ],
  "bindings": [
    {
      "source": "evolution",
      "vhost": "/",
      "destination": "anne.inbound.raw.q",
      "destination_type": "queue",
      "routing_key": "messages.upsert",
      "arguments": {}
    },
    {
      "source": "evolution",
      "vhost": "/",
      "destination": "anne.inbound.raw.q",
      "destination_type": "queue",
      "routing_key": "*.messages.upsert",
      "arguments": {}
    },
    {
      "source": "evolution",
      "vhost": "/",
      "destination": "anne.inbound.raw.q",
      "destination_type": "queue",
      "routing_key": "MESSAGES_UPSERT",
      "arguments": {}
    },
    {
      "source": "anne.direct.work",
      "vhost": "/",
      "destination": "anne.inbound.raw.q",
      "destination_type": "queue",
      "routing_key": "inbound.received",
      "arguments": {}
    },
    {
      "source": "anne.direct.work",
      "vhost": "/",
      "destination": "anne.ai.process.q",
      "destination_type": "queue",
      "routing_key": "ai.process",
      "arguments": {}
    },
    {
      "source": "anne.direct.work",
      "vhost": "/",
      "destination": "anne.outbound.dispatch.q",
      "destination_type": "queue",
      "routing_key": "outbound.dispatch",
      "arguments": {}
    },
    {
      "source": "anne.direct.dlx",
      "vhost": "/",
      "destination": "anne.inbound.raw.dlq",
      "destination_type": "queue",
      "routing_key": "dlq.inbound",
      "arguments": {}
    },
    {
      "source": "anne.direct.dlx",
      "vhost": "/",
      "destination": "anne.ai.process.dlq",
      "destination_type": "queue",
      "routing_key": "dlq.ai",
      "arguments": {}
    },
    {
      "source": "anne.direct.dlx",
      "vhost": "/",
      "destination": "anne.outbound.dispatch.dlq",
      "destination_type": "queue",
      "routing_key": "dlq.outbound",
      "arguments": {}
    }
  ],
  "policies": [
    {
      "vhost": "/",
      "name": "anne_quorum_limits",
      "pattern": "^(anne\\..*\\.q|evolution\\.messages\\.upsert)$",
      "apply-to": "queues",
      "definition": {
        "overflow": "reject-publish",
        "max-length": 10000
      },
      "priority": 1
    },
    {
      "vhost": "/",
      "name": "evolution_ingress_dlx",
      "pattern": "^evolution\\.messages\\.upsert$",
      "apply-to": "queues",
      "definition": {
        "delivery-limit": 3,
        "dead-letter-exchange": "anne.direct.dlx",
        "dead-letter-routing-key": "dlq.inbound"
      },
      "priority": 2
    },
    {
      "vhost": "/",
      "name": "anne_dlq_retention",
      "pattern": "^anne\\..*\\.dlq$",
      "apply-to": "queues",
      "definition": {
        "max-length": 5000,
        "message-ttl": 604800000
      },
      "priority": 1
    }
  ]
}
