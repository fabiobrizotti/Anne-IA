# ============================================================================
# NGINX CONFIGURATION — Anne-IA Reverse Proxy (HTTP Only)
# ============================================================================
# TLS é terminado pelo WireGuard do Tailscale (camada de transporte).
# Nginx roda em HTTP (porta 8080 no container), bind no IP Tailscale da VPS.
# ============================================================================

user root;
worker_processes auto;
pid /tmp/nginx/nginx.pid;

events {
    worker_connections 1024;
    use epoll;
    multi_accept on;
}

http {
    # WebSocket upgrade mapping
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }
    # Básico
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    server_tokens off;

    # MIME
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Logging
    access_log /var/log/nginx/access.log combined;
    error_log /var/log/nginx/error.log warn;

    # Gzip
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss application/atom+xml image/svg+xml;

    # Rate limiting zones (definidos em snippets/rate-limits.conf)
    include /tmp/nginx/snippets/rate-limits.conf;

    # Upstreams (serviços backend)
    upstream dashboard_backend {
        server dashboard:3000;
        keepalive 32;
    }

    upstream n8n_backend {
        server n8n:${N8N_PORT};
        keepalive 32;
    }

    upstream pgadmin_backend {
        server pgadmin:80;
        keepalive 16;
    }

    upstream rabbitmq_mgmt_backend {
        server rabbitmq:15672;
        keepalive 16;
    }

    # Default server — bloqueia hosts desconhecidos (444 = conexão fechada sem resposta)
    server {
        listen 8080 default_server;
        listen [::]:8080 default_server;
        server_name _;
        return 444;
    }

    # Main server — bind no IP Tailscale (definido via variável de ambiente)
    server {
        listen ${NGINX_CONTAINER_PORT};
        server_name ${TAILSCALE_HOSTNAME} localhost 127.0.0.1;

        # Security headers (snippet)
        include /tmp/nginx/snippets/security-headers.conf;

        # Healthcheck endpoint (interno, sem rate limit)
        location = /nginx-health {
            access_log off;
            return 200 "healthy\n";
            add_header Content-Type text/plain;
        }

        # Dashboard — limites estritos, SSE support
        location / {
            limit_req zone=api burst=${NGINX_RATE_LIMIT_BURST_API} nodelay;
            limit_conn perip 20;
            include /tmp/nginx/snippets/proxy-params.conf;
            proxy_pass http://dashboard_backend;
        }

        # Dashboard Auth — rate limit agressivo anti-brute-force
        location = /api/v1/auth/login {
            limit_req zone=login burst=${NGINX_RATE_LIMIT_BURST_LOGIN} nodelay;
            limit_conn perip 5;
            include /tmp/nginx/snippets/proxy-params.conf;
            proxy_pass http://dashboard_backend;
        }

        location = /api/v1/auth/register {
            limit_req zone=login burst=${NGINX_RATE_LIMIT_BURST_LOGIN} nodelay;
            limit_conn perip 5;
            include /tmp/nginx/snippets/proxy-params.conf;
            proxy_pass http://dashboard_backend;
        }

        # Dashboard Conhecimento — upload de arquivos (body maior)
        location /api/v1/conhecimento {
            client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE_CONHECIMENTO:-2m};
            limit_req zone=api burst=${NGINX_RATE_LIMIT_BURST_API} nodelay;
            include /tmp/nginx/snippets/proxy-params.conf;
            proxy_pass http://dashboard_backend;
        }

        # Dashboard Logs SSE — streaming, sem buffer, timeout longo
        location /api/v1/logs/stream {
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 1h;
            proxy_send_timeout 1h;
            include /tmp/nginx/snippets/proxy-params.conf;
            proxy_pass http://dashboard_backend;
        }

        # n8n — WebSocket/SSE support para editor
        # N8N_PATH=/n8n/ está configurado no n8n; o proxy deve retirar o prefixo /n8n/
        # ao encaminhar para o backend (proxy_pass COM barra final).
        location /n8n/ {
            # WebSocket upgrade
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";

            limit_req zone=api burst=${NGINX_RATE_LIMIT_BURST_API} nodelay;
            limit_conn perip 30;
            include /tmp/nginx/snippets/proxy-params.conf;
            proxy_pass http://n8n_backend/;
        }

        # pgAdmin — o header X-Script-Name faz o app gerar links com o prefixo
        location /pgadmin/ {
            limit_req zone=api burst=${NGINX_RATE_LIMIT_BURST_API} nodelay;
            include /tmp/nginx/snippets/proxy-params.conf;
            proxy_set_header X-Script-Name /pgadmin;
            proxy_pass http://pgadmin_backend;
        }

        # RabbitMQ Management — servido sob /rabbitmq conforme management.path_prefix
        location /rabbitmq/ {
            limit_req zone=api burst=${NGINX_RATE_LIMIT_BURST_API} nodelay;
            include /tmp/nginx/snippets/proxy-params.conf;
            proxy_pass http://rabbitmq_mgmt_backend;
        }

        # Bloquear acesso direto a APIs internas sensíveis
        location ~ ^/(api/v1/auth|api/v1/logs/ingest|api/v1/permissoes) {
            # Estas rotas já têm autenticação própria no backend
            # Rate limit extra aqui é defesa em profundidade
            limit_req zone=api burst=10 nodelay;
            include /tmp/nginx/snippets/proxy-params.conf;
            proxy_pass http://dashboard_backend;
        }
    }
}